---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/inter/latin-800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { SITE } from '../data/site';
import { PERSON, ORG, WEBSITE } from '../data/schema';

interface Props {
  title: string;
  description: string;
  /** Path such as "/" or "/about" — used for the canonical URL */
  path: string;
  active?: string;
  crumbs?: { name: string; href: string }[];
  pageType?: 'WebPage' | 'ProfilePage' | 'ContactPage' | 'CollectionPage';
  nodes?: Record<string, unknown>[];
  robots?: string;
  /** Bare mode: no site header/footer/schema (used for the Fiverr-safe page) */
  bare?: boolean;
}
const { title, description, path, active, crumbs, pageType = 'WebPage', nodes = [],
  robots = 'index, follow, max-image-preview:large', bare = false } = Astro.props;

if (title.length > 60) throw new Error(`Title too long (${title.length}): ${title}`);
if (description.length > 160) throw new Error(`Description too long (${description.length}): ${description}`);

const url = new URL(path, SITE.url).href.replace(/\/$/, path === '/' ? '/' : '');
const ogImage = `${SITE.url}/assets/og-image.png`;
const graph = [
  PERSON, ORG, WEBSITE,
  {
    '@type': pageType, '@id': `${url}#webpage`, url, name: title, description,
    isPartOf: { '@id': `${SITE.url}/#website` },
    [pageType === 'ProfilePage' ? 'mainEntity' : 'about']: { '@id': `${SITE.url}/#person` },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage }, inLanguage: 'en', dateModified: SITE.lastUpdated,
  },
  ...nodes,
  ...(crumbs ? [{ '@type': 'BreadcrumbList', itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, SITE.url).href })) }] : []),
];
const jsonld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="author" content="Mahamodul Hasan Moon" />
  <meta name="robots" content={robots} />
  <meta name="generator" content={Astro.generator} />
  {!bare && <link rel="canonical" href={url} />}
  {!bare && (
    <Fragment>
      <meta property="og:type" content={pageType === 'ProfilePage' ? 'profile' : 'website'} />
      <meta property="og:site_name" content="Mahamodul Hasan Moon" />
      <meta property="og:title" content={title} />
      <meta property="og:description" content={description} />
      <meta property="og:url" content={url} />
      <meta property="og:image" content={ogImage} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta property="og:image:alt" content="Mahamodul Hasan Moon, full stack developer, AI automation and DevOps" />
      <meta property="og:locale" content="en_US" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={title} />
      <meta name="twitter:description" content={description} />
      <meta name="twitter:image" content={ogImage} />
      <meta name="geo.region" content="BD-13" />
      <meta name="geo.placename" content="Dhaka" />
      <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
    </Fragment>
  )}
  <meta name="theme-color" content="#0b0f19" />
  <link rel="icon" href="/assets/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="manifest" href="/site.webmanifest" />
  {!bare && <script type="application/ld+json" set:html={jsonld} />}
</head>
<body class="overflow-x-hidden bg-ink-900 font-sans text-slate-200 antialiased">
  {bare ? <slot /> : (
    <Fragment>
      <a href="#main" class="skip-link">Skip to content</a>
      <div class="pointer-events-none fixed inset-0 -z-10 overflow-hidden" aria-hidden="true">
        <div class="absolute -left-24 -top-32 h-96 w-96 animate-blob rounded-full bg-brand-500/20 blur-3xl"></div>
        <div class="absolute -right-24 top-1/3 h-96 w-96 animate-blob rounded-full bg-violet-500/15 blur-3xl [animation-delay:-5s]"></div>
        <div class="absolute bottom-0 left-1/3 h-80 w-80 animate-blob rounded-full bg-cyan-400/10 blur-3xl [animation-delay:-9s]"></div>
      </div>
      <Header active={active} />
      {crumbs && <Breadcrumbs crumbs={crumbs} />}
      <main id="main"><slot /></main>
      <Footer />
    </Fragment>
  )}
  <script>
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('is-visible'); io.unobserve(e.target); }
    }), { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    const nav = document.getElementById('navbar');
    if (nav) {
      const onScroll = () => { const s = window.scrollY > 20; ['bg-ink-900/85', 'backdrop-blur-md', 'border-ink-700'].forEach((c) => nav.classList.toggle(c, s)); };
      addEventListener('scroll', onScroll, { passive: true }); onScroll();
    }
    const btn = document.getElementById('menuBtn'), menu = document.getElementById('mobileMenu');
    if (btn && menu) {
      btn.addEventListener('click', () => { const closed = menu.classList.toggle('hidden'); btn.setAttribute('aria-expanded', String(!closed)); });
      menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.classList.add('hidden')));
    }

    const cio = new IntersectionObserver((es) => es.forEach((e) => {
      if (!e.isIntersecting) return; cio.unobserve(e.target);
      const el = e.target as HTMLElement, end = Number(el.dataset.count), suf = el.dataset.suffix || '';
      if (reduce) return;
      let t0: number | null = null;
      const step = (t: number) => { if (t0 === null) t0 = t; const p = Math.min((t - t0) / 1400, 1); el.textContent = Math.round(end * (1 - Math.pow(1 - p, 3))) + suf; if (p < 1) requestAnimationFrame(step); };
      requestAnimationFrame(step);
    }), { threshold: 0.5 });
    document.querySelectorAll('[data-count]').forEach((el) => cio.observe(el));

    document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((b) => b.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${b.dataset.yt}?autoplay=1&rel=0`;
      f.title = 'Intro video: Meet Moon'; f.className = 'h-full w-full';
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen'; f.allowFullscreen = true;
      b.replaceWith(f);
    }));
  </script>
</body>
</html>
