---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout path="/404" robots="noindex, follow" title="Page not found | Mahamodul Hasan Moon" description="The page you requested could not be found.">
  <section class="px-5 py-40 text-center">
    <p class="eyebrow">404</p>
    <h1 class="h1 mt-3">Page not found</h1>
    <p class="mt-6 text-slate-400">The page you are looking for does not exist.</p>
    <a href="/" class="btn-primary mt-8">Back to home <Icon name="arrow" class="h-4 w-4" /></a>
  </section>
</BaseLayout>
