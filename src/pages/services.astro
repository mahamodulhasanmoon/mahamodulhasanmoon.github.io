---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import ServiceCard from '../components/ServiceCard.astro';
import SectionHead from '../components/SectionHead.astro';
import Cta from '../components/Cta.astro';
import { SITE, SERVICES, FAQ, PROCESS } from '../data/site';
const nodes = [
  { '@type': 'FAQPage', '@id': `${SITE.url}/services.html#faq`, mainEntity: FAQ.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
  ...SERVICES.map((s) => ({ '@type': 'Service', name: s.title, description: s.text, provider: { '@id': `${SITE.url}/#person` }, areaServed: 'Worldwide' })),
];
---
<BaseLayout path="/services.html" active="Services" nodes={nodes}
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Services', href: '/services.html' }]}
  title="Full Stack, AI Automation & DevOps Services | Moon"
  description="Full-stack development, AI automation, Docker and CI/CD, AWS and VPS deployment, and Stripe, bKash and SSLCommerz payment integration.">
  <PageIntro eyebrow="Services" title="Full stack, AI automation & DevOps services"
    lead="Mahamodul Hasan Moon offers full-stack development, AI automation, Docker and CI/CD, AWS and VPS deployment, payment integration and ongoing support." />
  <section class="px-5 pb-24"><div class="mx-auto grid max-w-6xl gap-6 md:grid-cols-2 lg:grid-cols-3">{SERVICES.map((s, i) => <ServiceCard service={s} index={i} detailed />)}</div></section>
  <section class="border-t border-ink-700/60 px-5 py-24">
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow="Process" title="How a project runs" />
      <ol class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {PROCESS.map((p, i) => <li class:list={['reveal card', `d${i % 3}`]}><span class="text-gradient text-4xl font-extrabold">{p.n}</span><h3 class="mt-3 text-lg font-semibold text-white">{p.title}</h3><p class="mt-2 text-sm text-slate-400">{p.text}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="border-t border-ink-700/60 px-5 py-24" aria-labelledby="faq-h">
    <div class="mx-auto max-w-3xl">
      <SectionHead eyebrow="FAQ" title="Frequently asked questions" id="faq-h" />
      <div class="space-y-4">
        {FAQ.map(([q, a]) => (
          <details class="reveal group rounded-2xl border border-ink-700 bg-ink-800 p-6 open:border-brand-500/50">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-white">{q}<span class="text-brand-400 transition group-open:rotate-45"><Icon name="plus" /></span></summary>
            <p class="mt-4 leading-relaxed text-slate-400">{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <Cta />
</BaseLayout>
