---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import RoleBadges from '../components/RoleBadges.astro';
import ProfilePhoto from '../components/ProfilePhoto.astro';
import Stats from '../components/Stats.astro';
import IntroVideo from '../components/IntroVideo.astro';
import Facts from '../components/Facts.astro';
import SectionHead from '../components/SectionHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CaseCard from '../components/CaseCard.astro';
import Review from '../components/Review.astro';
import Cta from '../components/Cta.astro';
import { SITE, SERVICES, HOME_STACK } from '../data/site';
const cases = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout path="/" active="Home"
  title="Mahamodul Hasan Moon | Full Stack, AI Automation & DevOps"
  description="Mahamodul Hasan Moon: full-stack developer, AI automation specialist and DevOps engineer in Dhaka. Next.js, Node.js, NestJS, Docker, AWS.">
  <section class="relative px-5 pb-20 pt-28 md:pt-36">
    <div class="mx-auto grid max-w-7xl items-center gap-14 lg:grid-cols-2">
      <div>
        <p class="inline-flex animate-fadeInUp items-center gap-2 rounded-full border border-emerald-400/40 bg-emerald-400/10 px-3 py-1 text-xs font-medium text-emerald-300">
          <span class="relative flex h-2 w-2"><span class="absolute inline-flex h-full w-full animate-pulseRing rounded-full bg-emerald-400"></span><span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-400"></span></span>
          Available for new projects
        </p>
        <p class="mt-8 animate-fadeInUp font-mono text-lg text-brand-400 [animation-delay:.05s]"><span class="text-slate-500">//</span> Hi, I&rsquo;m</p>
        <h1 class="mt-3 animate-fadeInUp text-5xl font-extrabold leading-[1.05] tracking-tight text-white [animation-delay:.1s] sm:text-6xl lg:text-7xl">
          Mahamodul Hasan <span class="text-gradient">Moon</span>
        </h1>
        <div class="mt-6 animate-fadeInUp [animation-delay:.15s]"><RoleBadges /></div>
        <p class="mt-6 max-w-xl animate-fadeInUp text-lg leading-relaxed text-slate-300 [animation-delay:.2s]">
          I build full stack web apps, automate business workflows with AI, and ship them to production with Docker and AWS. <span class="text-slate-400">6+ years of experience, based in Dhaka, Bangladesh, working with clients worldwide.</span>
        </p>
        <div class="mt-8 flex animate-fadeInUp flex-wrap gap-4 [animation-delay:.3s]">
          <a href="/contact.html" class="btn-primary">Start a project <Icon name="arrow" class="h-4 w-4" /></a>
          <a href="/case-studies.html" class="btn-ghost">View case studies</a>
        </div>
        <div class="mt-8 flex animate-fadeInUp flex-wrap items-center gap-x-6 gap-y-3 text-sm text-slate-400 [animation-delay:.4s]">
          <span class="flex items-center gap-2"><Icon name="pin" class="h-4 w-4 text-brand-400" /> Dhaka, Bangladesh</span>
          <a href={SITE.upwork} target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-white"><Icon name="briefcase" class="h-4 w-4 text-brand-400" /> Upwork</a>
          <a href={SITE.fiverr} target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-white"><Icon name="store" class="h-4 w-4 text-brand-400" /> Fiverr</a>
          <a href={SITE.github} target="_blank" rel="noopener" class="flex items-center gap-2 hover:text-white"><Icon name="github" class="h-4 w-4 text-brand-400" /> GitHub</a>
        </div>
      </div>
      <div class="flex animate-fadeInUp justify-center [animation-delay:.2s] lg:justify-end">
        <div class="relative animate-float">
          <div class="absolute -inset-5 rounded-[2rem] bg-gradient-to-tr from-brand-500 via-violet-500 to-cyan-400 opacity-30 blur-2xl" aria-hidden="true"></div>
          <ProfilePhoto eager class="relative aspect-square w-full max-w-[22rem] rounded-[2rem] border border-white/10 object-cover shadow-2xl sm:max-w-[30rem] lg:max-w-[36rem]" />
          <div class="absolute -bottom-5 -left-6 flex items-center gap-3 rounded-2xl border border-ink-700 bg-ink-800/95 px-4 py-3 shadow-xl backdrop-blur">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500/15 text-brand-400"><Icon name="sparkles" /></span>
            <span class="text-sm"><span class="block font-semibold text-white">6+ years</span><span class="text-slate-400">Full Stack &middot; AI &middot; DevOps</span></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="px-5 pb-20"><Stats /></section>
  <IntroVideo />

  <section class="border-t border-ink-700/60 px-5 py-20" aria-labelledby="facts-h">
    <div class="reveal mx-auto max-w-4xl"><h2 id="facts-h" class="eyebrow mb-6">Quick facts</h2><Facts /></div>
  </section>

  <section class="border-t border-ink-700/60 px-5 py-24">
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow="Services" title="What I build for clients" lead="Full stack apps, AI automation and DevOps, delivered end to end." />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{SERVICES.map((s, i) => <ServiceCard service={s} index={i} />)}</div>
      <div class="reveal mt-10 text-center"><a href="/services.html" class="btn-ghost">All services and FAQ <Icon name="arrow" class="h-4 w-4" /></a></div>
    </div>
  </section>

  <section class="border-t border-ink-700/60 px-5 py-24">
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow="Case studies" title="Selected client work" lead="Web, ERP, FinTech and DevOps projects with real results." />
      <div class="grid gap-6 md:grid-cols-2">{cases.map((c, i) => <CaseCard entry={c} index={i} />)}</div>
    </div>
  </section>

  <section class="border-t border-ink-700/60 px-5 py-24">
    <div class="mx-auto max-w-4xl"><SectionHead eyebrow="Client review" title="What clients say" /><Review /></div>
  </section>

  <section class="border-t border-ink-700/60 px-5 py-24">
    <div class="mx-auto max-w-5xl text-center">
      <SectionHead eyebrow="Tech stack" title="Tools I use every day" />
      <div class="reveal flex flex-wrap justify-center gap-2.5">{HOME_STACK.map((x) => <span class="chip">{x}</span>)}</div>
      <a href="/skills.html" class="reveal mt-8 inline-flex items-center gap-1.5 text-brand-400 hover:underline">Full skills list <Icon name="arrow" class="h-4 w-4" /></a>
    </div>
  </section>
  <Cta />
</BaseLayout>
