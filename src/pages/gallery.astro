---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import PageIntro from '../components/PageIntro.astro';
import Lightbox from '../components/Lightbox.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';

const entries = (await getCollection('events', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const fmt = (d: Date) => d.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const events = await Promise.all(entries.map(async (e) => ({
  id: e.id,
  ...e.data,
  dateLabel: fmt(e.data.date),
  iso: e.data.date.toISOString().slice(0, 10),
  Content: (await render(e)).Content,
  photos: await Promise.all(e.data.photos.map(async (p) => ({
    ...p,
    full: await getImage({ src: p.src, width: Math.min(1800, p.src.width), format: 'webp' }),
  }))),
})));
const total = events.reduce((n, e) => n + e.photos.length, 0);

const nodes = events.map((e) => ({
  '@type': 'ImageGallery', '@id': `${SITE.url}/gallery#${e.id}`, name: e.title, description: e.description,
  dateCreated: e.iso, contentLocation: { '@type': 'Place', name: e.location },
  author: { '@id': `${SITE.url}/#person` },
  image: e.photos.map((p) => ({ '@type': 'ImageObject', contentUrl: new URL(p.full.src, SITE.url).href, caption: p.caption || p.alt })),
}));
---
<BaseLayout path="/gallery" active="Gallery" pageType="CollectionPage" nodes={nodes}
  robots={events.length ? undefined : 'noindex, follow'}
  crumbs={[{ name: 'Home', href: '/' }, { name: 'Gallery', href: '/gallery' }]}
  title="Gallery: Events & Moments | Mahamodul Hasan Moon"
  description="Photos of Mahamodul Hasan Moon at tech events, conferences, meetups, workshops and client projects.">
  <PageIntro eyebrow="Gallery" title="Events & moments"
    lead="Photos of Mahamodul Hasan Moon at tech events, conferences, meetups, workshops and client projects." />

  {events.length === 0 ? (
    <section class="px-5 pb-24">
      <div class="reveal mx-auto max-w-xl rounded-3xl border border-dashed border-ink-700 bg-ink-800/60 p-12 text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-500/15 text-brand-400"><Icon name="image" class="h-7 w-7" /></span>
        <h2 class="mt-6 text-xl font-semibold text-white">Photos coming soon</h2>
        <p class="mt-2 text-slate-400">Event photos will appear here.</p>
      </div>
    </section>
  ) : (
    <Fragment>
      {events.length > 1 && (
        <div class="sticky top-16 z-30 mb-10 border-y border-ink-700/60 bg-ink-900/85 px-5 py-3 backdrop-blur-md">
          <div class="mx-auto flex max-w-6xl gap-2 overflow-x-auto" role="toolbar" aria-label="Filter by event">
            <button type="button" data-filter="all" aria-pressed="true" class="filter-btn">All <span class="opacity-60">{total}</span></button>
            {events.map((e) => <button type="button" data-filter={e.id} aria-pressed="false" class="filter-btn">{e.title} <span class="opacity-60">{e.photos.length}</span></button>)}
          </div>
        </div>
      )}
      <div class="px-5 pb-24"><div class="mx-auto max-w-6xl space-y-20">
        {events.map((e) => (
          <section id={e.id} data-event={e.id} class="scroll-mt-32" aria-labelledby={`${e.id}-h`}>
            <header class="reveal mb-8 flex flex-col gap-4 border-l-2 border-brand-500 pl-5 md:flex-row md:items-end md:justify-between">
              <div>
                <h2 id={`${e.id}-h`} class="text-2xl font-bold text-white sm:text-3xl">{e.title}</h2>
                <p class="mt-2 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm text-slate-400">
                  <span class="flex items-center gap-1.5"><Icon name="calendar" class="h-4 w-4 text-brand-400" /><time datetime={e.iso}>{e.dateLabel}</time></span>
                  <span class="flex items-center gap-1.5"><Icon name="pin" class="h-4 w-4 text-brand-400" />{e.location}</span>
                  <span class="flex items-center gap-1.5"><Icon name="image" class="h-4 w-4 text-brand-400" />{e.photos.length} {e.photos.length === 1 ? 'photo' : 'photos'}</span>
                </p>
                <p class="mt-3 max-w-2xl text-slate-300">{e.description}</p>
                <div class="prose-event mt-3 max-w-2xl text-slate-400"><e.Content /></div>
              </div>
            </header>
            <div class:list={["gap-4", e.photos.length === 1 ? "max-w-xl columns-1" : e.photos.length === 2 ? "max-w-4xl columns-1 sm:columns-2" : "columns-2 md:columns-3"]}>
              {e.photos.map((p) => (
                <a href={p.full.src} data-lb data-alt={p.alt} data-caption={p.caption} data-event={`${e.title} · ${e.dateLabel}`}
                  class="group relative mb-4 block break-inside-avoid overflow-hidden rounded-2xl border border-ink-700 bg-ink-800">
                  <Image src={p.src} alt={p.alt} widths={[400, 800]} sizes={e.photos.length === 1 ? "(min-width: 640px) 576px, 100vw" : e.photos.length === 2 ? "(min-width: 640px) 440px, 100vw" : "(min-width: 768px) 360px, 50vw"} loading="lazy"
                    class="h-auto w-full transition duration-500 group-hover:scale-105" />
                  <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/80 via-transparent to-transparent opacity-0 transition group-hover:opacity-100"></span>
                  {p.caption && <span class="pointer-events-none absolute inset-x-3 bottom-3 translate-y-2 text-sm font-medium text-white opacity-0 transition group-hover:translate-y-0 group-hover:opacity-100">{p.caption}</span>}
                </a>
              ))}
            </div>
          </section>
        ))}
      </div></div>
      <Lightbox />
    </Fragment>
  )}
  <Cta title="Want to work together?" />
</BaseLayout>

<script>
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.filter;
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    document.querySelectorAll<HTMLElement>('[data-event]').forEach((s) => { if (s.tagName === 'SECTION') s.hidden = f !== 'all' && s.dataset.event !== f; });
    document.querySelectorAll('section[data-event] .reveal').forEach((r) => r.classList.add('is-visible'));
  }));
</script>
