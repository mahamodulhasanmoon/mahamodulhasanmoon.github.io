---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import SectionHead from './SectionHead.astro';

const events = (await getCollection('events', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
// Latest 4 photos, newest events first
const photos = events.flatMap((e) => e.data.photos.map((p) => ({ ...p, event: e.data.title, id: e.id }))).slice(0, 4);
---
{photos.length > 0 && (
  <section class="border-t border-ink-700/60 px-5 py-24">
    <div class="mx-auto max-w-6xl">
      <SectionHead eyebrow="Gallery" title="Events & moments" lead="A look beyond the code: events, trips and everyday moments." />
      <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
        {photos.map((p, i) => (
          <a href={`/gallery#${p.id}`} class:list={['reveal group relative block aspect-square overflow-hidden rounded-2xl border border-ink-700 bg-ink-800', `d${i % 3}`]}>
            <Image src={p.src} alt={p.alt} widths={[300, 600]} sizes="(min-width: 768px) 280px, 50vw" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
            <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink-950/85 via-transparent to-transparent"></span>
            <span class="pointer-events-none absolute inset-x-3 bottom-3 text-sm font-medium text-white">{p.event}</span>
          </a>
        ))}
      </div>
      <div class="reveal mt-10 text-center"><a href="/gallery" class="btn-ghost">View full gallery <Icon name="arrow" class="h-4 w-4" /></a></div>
    </div>
  </section>
)}
