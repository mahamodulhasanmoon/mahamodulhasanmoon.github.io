---
import Icon from './Icon.astro';
---
<ul class="flex flex-wrap gap-2.5" aria-label="Roles">
  <li class="inline-flex items-center gap-2 rounded-full border border-brand-500/40 bg-brand-500/10 px-4 py-2 text-sm font-semibold text-brand-400"><Icon name="code" class="h-4 w-4" /> Full Stack Developer</li>
  <li class="inline-flex items-center gap-2 rounded-full border border-violet-400/40 bg-violet-500/10 px-4 py-2 text-sm font-semibold text-violet-300"><Icon name="sparkles" class="h-4 w-4" /> AI Automation</li>
  <li class="inline-flex items-center gap-2 rounded-full border border-cyan-400/40 bg-cyan-400/10 px-4 py-2 text-sm font-semibold text-cyan-300"><Icon name="cloud" class="h-4 w-4" /> DevOps</li>
</ul>
