---
interface Props { eyebrow: string; title: string; lead: string }
const { eyebrow, title, lead } = Astro.props;
---
<section class="px-5 pb-14 pt-8"><div class="mx-auto max-w-4xl text-center">
  <p class="eyebrow animate-fadeInUp">{eyebrow}</p>
  <h1 class="h1 mt-3 animate-fadeInUp [animation-delay:.1s]">{title}</h1>
  <p class="mx-auto mt-6 max-w-3xl animate-fadeInUp text-lg leading-relaxed text-slate-400 [animation-delay:.2s]">{lead}</p>
</div></section>
