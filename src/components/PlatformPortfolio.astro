---
// Platform-safe portfolio for sharing inside Fiverr / Upwork messages.
// NO email, phone, WhatsApp, GitHub or links to the main site. The only outbound link is the platform profile.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import RoleBadges from './RoleBadges.astro';
import ProfilePhoto from './ProfilePhoto.astro';
import Stats from './Stats.astro';
import SectionHead from './SectionHead.astro';
import ServiceCard from './ServiceCard.astro';
import CaseFull from './CaseFull.astro';
import Review from './Review.astro';
import { SERVICES, SKILLS } from '../data/site';

interface Props { path: string; platform: 'Fiverr' | 'Upwork'; href: string; icon: string; cta: string; closing: string }
const { path, platform, href, icon, cta, closing } = Astro.props;
const cases = (await getCollection('case-studies')).sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout bare path={path} robots="noindex, nofollow"
  title="Portfolio | Mahamodul Hasan Moon"
  description="Portfolio of Mahamodul Hasan Moon: full stack development, AI automation and DevOps projects.">
  <header class="border-b border-ink-700/60"><div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <img src="/assets/logo/icon.svg" width="40" height="40" alt="Mahamodul Hasan Moon logo" class="h-10 w-10" />
    <a href={href} target="_blank" rel="noopener" class="btn-primary !px-4 !py-2 text-sm"><Icon name={icon} class="h-4 w-4" /> {cta}</a>
  </div></header>
  <main id="main">
    <section class="px-5 py-16 md:py-24"><div class="mx-auto grid max-w-6xl items-center gap-12 lg:grid-cols-2">
      <div>
        <p class="font-mono text-lg text-brand-400"><span class="text-slate-500">//</span> Portfolio</p>
        <h1 class="mt-3 text-5xl font-extrabold leading-[1.05] tracking-tight text-white sm:text-6xl">Mahamodul Hasan <span class="text-gradient">Moon</span></h1>
        <div class="mt-6"><RoleBadges /></div>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-slate-300">I build full stack web apps, automate business workflows with AI, and ship them to production with Docker and AWS. 6+ years of experience.</p>
        <div class="mt-8"><a href={href} target="_blank" rel="noopener" class="btn-primary"><Icon name={icon} class="h-4 w-4" /> {cta}</a></div>
      </div>
      <div class="flex justify-center lg:justify-end"><ProfilePhoto eager alt="Mahamodul Hasan Moon" sizes="(min-width: 640px) 448px, 90vw" class="aspect-square w-full max-w-[22rem] rounded-[2rem] border border-white/10 object-cover shadow-2xl sm:max-w-[28rem]" /></div>
    </div></section>
    <section class="px-5 pb-20"><Stats /></section>
    <section class="border-t border-ink-700/60 px-5 py-20"><div class="mx-auto max-w-6xl"><SectionHead eyebrow="Services" title="What I can do for you" />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{SERVICES.map((s, i) => <ServiceCard service={s} index={i} />)}</div></div></section>
    <section class="border-t border-ink-700/60 px-5 py-20"><div class="mx-auto max-w-6xl"><SectionHead eyebrow="Projects" title="Selected work" />
      <div class="space-y-10">{cases.map((c, i) => <CaseFull entry={c} index={i} safe />)}</div></div></section>
    <section class="border-t border-ink-700/60 px-5 py-20"><div class="mx-auto max-w-4xl"><SectionHead eyebrow="Client review" title="What clients say" /><Review safe={platform !== 'Upwork'} /></div></section>
    <section class="border-t border-ink-700/60 px-5 py-20"><div class="mx-auto max-w-5xl text-center"><SectionHead eyebrow="Tech stack" title="Tools I use" />
      <div class="reveal flex flex-wrap justify-center gap-2.5">{SKILLS.flatMap((g) => g.items).map((x) => <span class="chip">{x}</span>)}</div></div></section>
    <section class="px-5 py-20"><div class="reveal mx-auto max-w-3xl rounded-3xl border border-ink-700 bg-ink-800 p-10 text-center">
      <h2 class="h2 !mt-0">Ready to start?</h2><p class="mt-4 text-slate-400">{closing}</p>
      <div class="mt-8"><a href={href} target="_blank" rel="noopener" class="btn-primary"><Icon name={icon} class="h-4 w-4" /> {cta}</a></div>
    </div></section>
  </main>
  <footer class="border-t border-ink-700/60 py-8 text-center text-xs text-slate-500">&copy; {new Date().getFullYear()} Mahamodul Hasan Moon</footer>
</BaseLayout>
