---
import Icon from './Icon.astro';
---
<dialog id="lightbox" aria-label="Photo viewer"
  class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-white backdrop:bg-ink-950/95 backdrop:backdrop-blur-sm">
  <div class="flex h-full w-full flex-col">
    <div class="flex items-center justify-between px-5 py-4">
      <p id="lb-counter" class="font-mono text-sm text-slate-400"></p>
      <button type="button" id="lb-close" class="rounded-full p-2 text-slate-300 transition hover:bg-white/10 hover:text-white" aria-label="Close"><Icon name="close" class="h-6 w-6" /></button>
    </div>
    <div class="relative flex min-h-0 flex-1 items-center justify-center px-4 sm:px-20">
      <button type="button" id="lb-prev" class="absolute left-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-ink-800/80 p-3 text-white transition hover:bg-brand-500 sm:left-5" aria-label="Previous photo"><Icon name="chevronLeft" class="h-6 w-6" /></button>
      <img id="lb-img" alt="" class="max-h-full max-w-full rounded-xl object-contain shadow-2xl" />
      <button type="button" id="lb-next" class="absolute right-2 top-1/2 z-10 -translate-y-1/2 rounded-full bg-ink-800/80 p-3 text-white transition hover:bg-brand-500 sm:right-5" aria-label="Next photo"><Icon name="chevronRight" class="h-6 w-6" /></button>
    </div>
    <div class="px-5 py-5 text-center">
      <p id="lb-caption" class="mx-auto max-w-2xl text-slate-200"></p>
      <p id="lb-event" class="mt-1 text-sm text-slate-400"></p>
    </div>
  </div>
</dialog>

<script>
  const dlg = document.getElementById('lightbox') as HTMLDialogElement | null;
  if (dlg) {
    const img = document.getElementById('lb-img') as HTMLImageElement;
    const cap = document.getElementById('lb-caption')!;
    const evt = document.getElementById('lb-event')!;
    const counter = document.getElementById('lb-counter')!;
    let items: HTMLAnchorElement[] = [];
    let idx = 0;
    const visible = () => [...document.querySelectorAll<HTMLAnchorElement>('[data-lb]')].filter((a) => a.offsetParent !== null);
    const show = (i: number) => {
      idx = (i + items.length) % items.length;
      const a = items[idx];
      img.src = a.href; img.alt = a.dataset.alt || '';
      cap.textContent = a.dataset.caption || a.dataset.alt || '';
      evt.textContent = a.dataset.event || '';
      counter.textContent = `${idx + 1} / ${items.length}`;
      const next = items[(idx + 1) % items.length]; if (next) { const pre = new Image(); pre.src = next.href; }
    };
    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('[data-lb]');
      if (!a) return;
      e.preventDefault(); items = visible(); show(items.indexOf(a)); dlg.showModal();
    });
    document.getElementById('lb-prev')!.addEventListener('click', () => show(idx - 1));
    document.getElementById('lb-next')!.addEventListener('click', () => show(idx + 1));
    document.getElementById('lb-close')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => { if (e.target === dlg || (e.target as HTMLElement).classList.contains('flex-1')) dlg.close(); });
    dlg.addEventListener('close', () => { img.removeAttribute('src'); });
    document.addEventListener('keydown', (e) => {
      if (!dlg.open) return;
      if (e.key === 'ArrowLeft') show(idx - 1);
      if (e.key === 'ArrowRight') show(idx + 1);
    });
    let x0: number | null = null;
    dlg.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    dlg.addEventListener('touchend', (e) => {
      if (x0 === null) return; const dx = e.changedTouches[0].clientX - x0; x0 = null;
      if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
    });
  }
</script>
